{
  "platform": "docker",
  "port": 3000,
  "healthCheck": {
    "command": "CMD node -e \"fetch('http://127.0.0.1:3000/api/health',{signal:AbortSignal.timeout(8000)}).then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))\"",
    "interval": 30,
    "timeout": 15,
    "retries": 3,
    "startPeriod": 120
  }
}
