{
  "name": "portal-ai",
  "version": "1.7.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "dev:liara": "next dev",
    "build:liara": "npm run build",
    "start:liara": "node scripts/start.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "security:check": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "test": "npm run security:check && npm run deployment:check && npm run typecheck && npm run lint",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "eslint . --ignore-pattern .next",
    "preflight": "node scripts/preflight.mjs",
    "deployment:check": "node --test tests/deployment.test.mjs tests/migration-status.test.mjs tests/migration-compatibility.test.mjs tests/migration-report.test.mjs",
    "deployment:integration": "node --test tests/deployment-integration.test.mjs",
    "db:status": "node scripts/migration-status.mjs",
    "deployment:startup": "node --test tests/startup-socket.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "bullmq": "^5.81.3",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "redis": "^5.12.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "embedded-postgres": "^18.4.0-beta.17"
  },
  "type": "module",
  "displayName": "Portal AI"
}
